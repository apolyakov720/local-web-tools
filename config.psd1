@{
    # Постоянное имя приложения
    Domain = 'myapp.test'
    
    # Локальная сеть
    LanIp         = '192.168.0.124'
    AllowedSubnet = '192.168.0.0/24'
    
    # DNS-серверы для пересылки внешних запросов
    DnsForwarders = @('192.168.0.1')
    
    # Локальный веб-сервер приложения
    AppUpstream = 'https://127.0.0.1:8483'
    
    # Время кеширования нашей DNS-записи, в секундах
    DnsTtl = 60
}
